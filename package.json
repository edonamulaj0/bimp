{
  "name": "bimp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run deploy:ingest && npm run deploy:web",
    "deploy:web": "vite build && wrangler deploy -c apps/web/dist/bimp/wrangler.json",
    "deploy:ingest": "wrangler deploy -c ingest/wrangler.jsonc",
    "preview:web": "vite build && wrangler versions upload -c apps/web/dist/bimp/wrangler.json",
    "test": "esbuild evals/standards.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bimp/standards.check.mjs --log-level=warning && node node_modules/.cache/bimp/standards.check.mjs",
    "typecheck": "tsc -p apps/api && tsc -p apps/web",
    "ingest:dev": "cd ingest && uvicorn service:app --port 8090 --reload",
    "ingest:fixtures": "cd ingest && python3 make_fixtures.py ../evals/fixtures",
    "db:migrate:local": "wrangler d1 migrations apply bimp --local",
    "db:migrate:remote": "wrangler d1 migrations apply bimp --remote"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "hono": "^4.13.18",
    "lenis": "^1.3.27",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
