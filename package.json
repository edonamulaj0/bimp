{
  "name": "bimp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p apps/api && tsc -p apps/web",
    "db:migrate:local": "wrangler d1 migrations apply bimp --local",
    "db:migrate:remote": "wrangler d1 migrations apply bimp --remote"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "hono": "^4.13.18",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
