{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bimp",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "bimp", "database_id": "07fca9b5-ac4a-463f-951d-a2c0e82f2e35", "migrations_dir": "db/migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "bimp-files" }],
  // Ingestion runs in the separate "bimp-ingest" Worker (ingest/wrangler.jsonc); this binding points at its Workflow.
  "workflows": [{ "name": "bimp-ingest", "binding": "INGEST_WORKFLOW", "class_name": "IngestWorkflow", "script_name": "bimp-ingest" }],
  "preview_urls": true,
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash",
    "ALLOW_SIGNUP": "true",
    // Optional: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>
    "AI_GATEWAY_URL": "",
    "AI_GATEWAY_URL": "",
    // Cloudinary image generation from the 3D model and for the site. The cloud name and API key are not secret;
    // the API secret is: set it with `wrangler secret put CLOUDINARY_API_SECRET`, never here.
    "CLOUDINARY_CLOUD_NAME": "fg8gkylc",
    "CLOUDINARY_API_KEY": "541313966371196"
  }
  // Secrets (never commit): GEMINI_API_KEY and CLOUDINARY_API_SECRET via `wrangler secret put …`, locally in .dev.vars
}
